# Exemplo de variáveis de ambiente; definir os valores no shell ou em .env local.
# python run.py lê o ambiente do processo. Este arquivo não é carregado sozinho.
TCC_SPADE_ENABLED=1
XMPP_ATENDIMENTO_PASSWORD=
XMPP_ESTOQUE_PASSWORD=
XMPP_PREVISAO_PASSWORD=
XMPP_CLIENT_PORT=5222
XMPP_SERVER_PORT=5269
AGENT_STARTUP_TIMEOUT=20
AGENT_REQUEST_TIMEOUT=5
AGENT_SHUTDOWN_TIMEOUT=10

# Opcional: carrega um manifesto privado na inicialização. Sem este valor,
# o agente recupera a execução ativa persistida pelo comando previsao carregar.
FORECAST_MANIFEST=
# Revisão aprovada exigida apenas para recalcular; não usar o CSV original.
FORECAST_REVIEW=
FORECAST_START=2022-01-01
FORECAST_CALENDAR_OVERRIDES=

# Alertas preventivos: dias de calendário; atualizados após mudanças e previsões.
PREDICTIVE_ALERT_HORIZON_DAYS=7
PREDICTIVE_ALERTS_AUTO_ENABLED=1
